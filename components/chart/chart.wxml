<!-- components/chart/chart.wxml - 图表组件模板 -->
<view class="chart-wrapper">
  <view class="chart-title" wx:if="{{title}}">{{title}}</view>

  <!-- 柱状图 / 折线图 -->
  <view class="chart-bar-container" wx:if="{{type === 'bar' || type === 'line'}}">
    <view class="bar-grid" wx:for="{{barItems}}" wx:key="_idx" style="--i:{{index}}">
      <view class="bar-label">{{item.label}}</view>
      <view class="bar-track">
        <view class="bar-fill" style="height:{{item.pct}}%; background:{{item.color}}; {{type === 'line' ? 'border-radius: 8rpx;' : ''}}">
          <text class="bar-value" wx:if="{{showValue}}">{{item.value}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 雷达图 -->
  <canvas class="chart-canvas" type="2d" wx:if="{{type === 'radar'}}"
          width="200" height="200"
          binderror="onCanvasError" style="width:200rpx; height:200rpx;">
  </canvas>

  <!-- 饼图 -->
  <canvas class="chart-canvas" type="2d" wx:if="{{type === 'pie'}}"
          width="200" height="200"
          binderror="onCanvasError" style="width:200rpx; height:200rpx;">
  </canvas>

  <!-- 数据列表（适用于饼图和其他需要明细的场景） -->
  <view class="chart-legend" wx:if="{{type === 'pie' && pieSegments.length}}">
    <view class="legend-item" wx:for="{{pieSegments}}" wx:key="_idx" style="--i:{{index}}">
      <view class="legend-dot" style="background:{{item.color}}"></view>
      <text class="legend-label">{{item.label}}</text>
      <text class="legend-value">{{item.value}}（{{item.pct}}%）</text>
    </view>
  </view>
</view>