/* components/chart/chart.wxss - 图表组件样式 */

.chart-wrapper {
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: var(--ivy-shadow);
}

.chart-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ivy-text);
  margin-bottom: 20rpx;
  text-align: center;
}

.chart-bar-container {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 320rpx;
  padding: 20rpx 10rpx 10rpx;
  border-bottom: 2rpx solid var(--ivy-border);
  position: relative;
}

.bar-grid {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  max-width: 120rpx;
  position: relative;
}

.bar-label {
  font-size: 20rpx;
  color: var(--ivy-text-light);
  margin-bottom: 12rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

.bar-track {
  flex: 1;
  width: 100%;
  background: var(--ivy-border);
  border-radius: 8rpx 8rpx 0 0;
  position: relative;
  min-height: 120rpx;
}

.bar-fill {
  position: absolute;
  bottom: 0;
  left: 4rpx;
  right: 4rpx;
  border-radius: 8rpx 8rpx 0 0;
  transition: height 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 8rpx;
}

.bar-value {
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
}

.chart-canvas {
  display: block;
  margin: 0 auto;
  width: 200rpx;
  height: 200rpx;
}

.chart-legend {
  margin-top: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--ivy-border);
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.legend-label {
  flex: 2;
  font-size: 26rpx;
  color: var(--ivy-text);
}

.legend-value {
  flex: 1;
  font-size: 24rpx;
  color: var(--ivy-text-light);
  text-align: right;
}