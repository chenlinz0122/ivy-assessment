/* components/progress-bar/progress-bar.wxss */
.progress-wrap { width: 100%; }
.progress-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.progress-text {
  font-size: 26rpx;
  color: #2E8B57;
  font-weight: 600;
}
.progress-percent {
  font-size: 24rpx;
  color: #7A8A7C;
}
.progress-track {
  height: 16rpx;
  background: #E8F0EA;
  border-radius: 8rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #3CB371, #2E8B57);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}
