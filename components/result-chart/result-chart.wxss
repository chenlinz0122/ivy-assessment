/* components/result-chart/result-chart.wxss */
.chart-wrap {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(46, 139, 87, 0.08);
}
.chart-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2C3E2D;
  margin-bottom: 24rpx;
  text-align: center;
}

.chart-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  color: #B8C5BC;
  font-size: 26rpx;
}
.loading-dot::after {
  content: '...';
  animation: dots 1.5s infinite;
}
@keyframes dots {
  0% { content: '.'; }
  33% { content: '..'; }
  66% { content: '...'; }
}

/* 柱状图 */
.bar-item {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  opacity: 0;
  animation: barFadeIn 0.5s ease forwards;
}
.bar-item:nth-child(1) { animation-delay: 0.1s; }
.bar-item:nth-child(2) { animation-delay: 0.2s; }
.bar-item:nth-child(3) { animation-delay: 0.3s; }
.bar-item:nth-child(4) { animation-delay: 0.4s; }
.bar-item:nth-child(5) { animation-delay: 0.5s; }
.bar-item:nth-child(6) { animation-delay: 0.6s; }
.bar-item:nth-child(7) { animation-delay: 0.7s; }
.bar-item:nth-child(8) { animation-delay: 0.8s; }
.bar-item:nth-child(9) { animation-delay: 0.9s; }
.bar-item:nth-child(10) { animation-delay: 1.0s; }
.bar-item:nth-child(11) { animation-delay: 1.1s; }
.bar-item:nth-child(12) { animation-delay: 1.2s; }
@keyframes barFadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.bar-label {
  width: 130rpx;
  font-size: 24rpx;
  color: #5A6B5D;
  flex-shrink: 0;
}
.bar-track {
  flex: 1;
  height: 32rpx;
  background: #EEF4EF;
  border-radius: 16rpx;
  overflow: hidden;
  margin: 0 16rpx;
}
.bar-fill {
  height: 100%;
  border-radius: 16rpx;
  transition: width 0.8s cubic-bezier(0.25, 0.1, 0.25, 1);
  position: relative;
}
.bar-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255,255,255,0.3) 0%, transparent 100%);
  border-radius: 16rpx 16rpx 0 0;
}
.bar-value {
  width: 60rpx;
  text-align: right;
  font-size: 24rpx;
  color: #2E8B57;
  font-weight: 600;
}

/* 雷达图 */
.radar-canvas {
  width: 640rpx;
  height: 540rpx;
  margin: 0 auto;
  display: block;
}

/* 仪表盘 */
.gauge-box {
  position: relative;
  width: 420rpx;
  height: 260rpx;
  margin: 20rpx auto;
}
.gauge-semi {
  position: absolute;
  top: 0;
  left: 0;
  width: 420rpx;
  height: 210rpx;
  border-radius: 210rpx 210rpx 0 0;
  overflow: hidden;
}
.gauge-arc-bg {
  position: absolute;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  border: 40rpx solid #EEF4EF;
  box-sizing: border-box;
  clip-path: inset(0 0 50% 0);
}
.gauge-arc-fill {
  position: absolute;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  border: 40rpx solid #2E8B57;
  box-sizing: border-box;
  clip-path: inset(0 50% 50% 0);
  transform-origin: center;
  transition: transform 0.8s cubic-bezier(0.25, 0.1, 0.25, 1);
}
.gauge-center {
  position: absolute;
  top: 110rpx;
  left: 0;
  right: 0;
  text-align: center;
}
.gauge-value {
  font-size: 64rpx;
  font-weight: 700;
  color: #2E8B57;
  line-height: 1;
}
.gauge-unit {
  font-size: 22rpx;
  color: #9AAAA0;
  margin-top: 6rpx;
}
.gauge-level {
  font-size: 28rpx;
  color: #2E8B57;
  font-weight: 600;
  margin-top: 12rpx;
}

/* 饼图 */
.pie-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pie-main {
  display: flex;
  width: 360rpx;
  height: 200rpx;
  border-radius: 100rpx;
  overflow: hidden;
  position: relative;
  box-shadow: inset 0 0 0 2rpx #FFFFFF;
}
.pie-item {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: flex 0.6s ease;
  position: relative;
}
.pie-item:first-child {
  border-radius: 100rpx 0 0 100rpx;
}
.pie-item:last-child {
  border-radius: 0 100rpx 100rpx 0;
}
.pie-item:not(:first-child):not(:last-child) {
  border-radius: 0;
}
.pie-value {
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
}
.pie-legend {
  width: 100%;
  margin-top: 24rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #E8EDE9;
}
.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 4rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.legend-label {
  flex: 2;
  font-size: 26rpx;
  color: #2C3E2D;
}
.legend-value {
  flex: 1;
  font-size: 24rpx;
  color: #7A8A7C;
  text-align: right;
}
