<!-- pages/assess/detail.wxml -->
<view class="detail-page" wx:if="{{assess}}">
  <!-- 头部 -->
  <view class="detail-header" style="background:linear-gradient(135deg, {{assess.color}}CC, {{assess.color}})">
    <view class="header-icon">{{assess.icon}}</view>
    <view class="header-name">{{assess.name}}</view>
    <view class="header-cat">{{assess.category}}</view>
    <view class="header-meta">
      <text>⏱ {{assess.duration}}</text>
      <text>👥 {{assess.participants}}人参与</text>
      <text>📝 {{questionCount}}题</text>
    </view>
  </view>

  <!-- 测评介绍 -->
  <view class="card">
    <view class="section-title">测评介绍</view>
    <view class="desc-text">{{assess.desc}}</view>
  </view>

  <!-- 报告内容 -->
  <view class="card">
    <view class="section-title">你将获得</view>
    <view class="report-list">
      <view class="report-item" wx:for="{{assess.reportItems}}" wx:key="*this">
        <text class="check">✓</text>
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 温馨提示 -->
  <view class="card">
    <view class="section-title">答题说明</view>
    <view class="tip-text">
      · 请根据真实情况作答，没有对错之分\n
      · 每题一屏，可返回修改上一题\n
      · 全部完成后自动生成专属报告\n
      · 报告可保存到"我的记录"
    </view>
  </view>

  <!-- 开始按钮 -->
  <view class="bottom-bar">
    <button class="btn-primary" bindtap="startAssess">开始测评</button>
  </view>
</view>
