/* pages/assess/result.wxss */
.result-page { padding: 0 24rpx 80rpx; }

/* 头部 */
.result-header {
  text-align: center;
  color: #FFFFFF;
  padding: 60rpx 40rpx;
  border-radius: 0 0 32rpx 32rpx;
  margin-bottom: 24rpx;
}
.rh-icon { font-size: 96rpx; margin-bottom: 16rpx; }
.rh-name { font-size: 40rpx; font-weight: 700; margin-bottom: 8rpx; }
.rh-sub { font-size: 24rpx; opacity: 0.85; margin-bottom: 20rpx; }
.rh-code {
  display: inline-block;
  padding: 10rpx 28rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin: 6rpx;
}

.result-page .card { margin-bottom: 24rpx; }
.section-title.warn { color: #E67E22; }
.section-content {
  font-size: 28rpx;
  color: #5A6B5D;
  line-height: 1.9;
  white-space: pre-line;
}
.section-content.warn-content {
  color: #E67E22;
  background: #FFF6EC;
  padding: 20rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid #E67E22;
}

/* TOP5 */
.top5-list { padding: 8rpx 0; }
.top5-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.top5-rank {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #E8F5EC;
  color: #2E8B57;
  border-radius: 12rpx;
  font-weight: 700;
  font-size: 26rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.top5-name {
  width: 140rpx;
  font-size: 28rpx;
  color: #2C3E2D;
  flex-shrink: 0;
}
.top5-bar {
  flex: 1;
  height: 24rpx;
  background: #EEF4EF;
  border-radius: 12rpx;
  overflow: hidden;
  margin-left: 16rpx;
}
.top5-fill {
  height: 100%;
  background: linear-gradient(90deg, #3CB371, #2E8B57);
  border-radius: 12rpx;
}

/* 操作区 */
.actions {
  display: flex;
  gap: 20rpx;
  margin: 32rpx 0 20rpx;
}
.action-btn { flex: 1; }
.more-btn { width: 100%; }

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: #B8C5BC;
  margin-top: 32rpx;
}
