/* pages/community/index.wxss - 社区广场 */

.community-page {
  padding: 24rpx;
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 页面标题 */
.page-head {
  padding: 24rpx 4rpx 16rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2C3E2D;
}
.page-sub {
  font-size: 24rpx;
  color: #7A8A7C;
  margin-top: 8rpx;
}

/* 顶部 Tab */
.tab-bar {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(46, 139, 87, 0.08);
  padding: 6rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #7A8A7C;
  padding: 20rpx 0;
  position: relative;
  border-radius: 18rpx;
  transition: all 0.2s ease;
}
.tab-item.active {
  color: #FFFFFF;
  font-weight: 700;
  background: linear-gradient(135deg, #3CB371, #2E8B57);
  box-shadow: 0 4rpx 12rpx rgba(46, 139, 87, 0.25);
}

/* 筛选排序栏 */
.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}
.sort-group {
  display: flex;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 6rpx;
  box-shadow: 0 4rpx 12rpx rgba(46, 139, 87, 0.06);
}
.sort-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #7A8A7C;
  border-radius: 22rpx;
  transition: all 0.2s ease;
  line-height: 1.2;
}
.sort-item.active {
  color: #FFFFFF;
  font-weight: 600;
  background: linear-gradient(135deg, #3CB371, #2E8B57);
}
.type-filter {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(46, 139, 87, 0.06);
  line-height: 1.2;
}
.type-filter-name {
  font-size: 26rpx;
  color: #2C3E2D;
  font-weight: 500;
}
.type-filter-arrow {
  font-size: 22rpx;
  color: #7A8A7C;
  margin-left: 8rpx;
  transition: transform 0.2s ease;
}
.type-filter-arrow.up {
  transform: rotate(180deg);
}

/* 类型筛选下拉菜单 */
.type-dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  background: transparent;
}
.type-dropdown {
  position: relative;
  z-index: 41;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(46, 139, 87, 0.15);
  margin-bottom: 20rpx;
  overflow: hidden;
}
.type-dropdown-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #2C3E2D;
  border-bottom: 1rpx solid #F0F4F1;
  transition: background 0.15s;
}
.type-dropdown-item:last-child {
  border-bottom: none;
}
.type-dropdown-item:active {
  background: #F5F7F6;
}
.type-dropdown-item.active {
  color: #2E8B57;
  font-weight: 600;
  background: #E8F5EC;
}
.check-icon {
  color: #2E8B57;
  font-size: 28rpx;
  font-weight: 700;
}

/* 帖子卡片 */
.post-list {
  margin-top: 4rpx;
}
.post-card {
  padding: 28rpx;
}
.post-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #E8F5EC, #C8E6D0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(46, 139, 87, 0.10);
  overflow: hidden;
}
.post-avatar.avatar-anon {
  background: linear-gradient(135deg, #E0E5E2, #C8D0CC);
  box-shadow: 0 4rpx 10rpx rgba(120, 130, 125, 0.10);
}
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 40rpx;
}
.post-author {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.post-nick {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3E2D;
}
.post-time {
  font-size: 22rpx;
  color: #9AAAA0;
  margin-top: 4rpx;
}

/* 测评类型标签（报告分享类） */
.assess-tag {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #E8F5EC, #D4ECD9);
  border-radius: 20rpx;
  padding: 8rpx 18rpx;
  flex-shrink: 0;
}
.assess-tag-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}
.assess-tag-text {
  font-size: 22rpx;
  color: #2E8B57;
  font-weight: 600;
}

/* 话题分类标签（话题讨论类） */
.cat-tag {
  font-size: 22rpx;
  color: #2E7D32;
  background: #E8F5EC;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* 话题帖卡片左侧色条强调 */
.post-card-topic {
  border-left: 6rpx solid #66BB6A;
}

.post-content {
  font-size: 28rpx;
  color: #2C3E2D;
  line-height: 1.7;
  margin-bottom: 20rpx;
}
.post-more {
  color: #2E7D32;
  font-weight: 600;
  margin-left: 8rpx;
}

/* 话题帖图片缩略图 */
.post-images {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}
.post-img-item {
  width: 180rpx;
  height: 180rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 10rpx rgba(46, 139, 87, 0.10);
}
.post-img-item image {
  width: 100%;
  height: 100%;
}

.post-foot {
  display: flex;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F4F1;
}
/* 话题讨论来源标识（右下角小字） */
.topic-source {
  margin-left: auto;
  font-size: 20rpx;
  color: #9AAAA0;
}
.foot-btn {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #7A8A7C;
  margin-right: 48rpx;
  transition: transform 0.12s ease;
}
.foot-btn:active {
  transform: scale(0.92);
}
.foot-icon {
  margin-right: 8rpx;
  font-size: 30rpx;
}
.foot-btn.liked {
  color: #E74C3C;
}

/* 话题卡片 */
.topic-list {
  margin-top: 4rpx;
}
.topic-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
}
.topic-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #E8F5EC, #C8E6D0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(46, 139, 87, 0.12);
}
.topic-main {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.topic-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.topic-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E2D;
  flex: 1;
  margin-bottom: 0;
}
.topic-hot-tag {
  font-size: 19rpx;
  color: #E65100;
  background: #FFF3E0;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  font-weight: 600;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.topic-desc {
  font-size: 24rpx;
  color: #7A8A7C;
  line-height: 1.5;
  margin-bottom: 8rpx;
}
.topic-join {
  font-size: 22rpx;
  color: #2E8B57;
}
.topic-arrow {
  font-size: 40rpx;
  color: #B8C5BC;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.tip-bottom {
  text-align: center;
  font-size: 24rpx;
  color: #B8C5BC;
  padding: 24rpx 0;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
}
.empty-emoji {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #7A8A7C;
  margin-bottom: 8rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #B8C5BC;
}

/* 悬浮发帖按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 60rpx;
  height: 96rpx;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #3CB371, #2E8B57);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(46, 139, 87, 0.35);
  z-index: 50;
}

/* 发帖弹层 */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.composer-box {
  width: 100%;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
.composer-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C3E2D;
  text-align: center;
  margin-bottom: 24rpx;
}
.composer-input {
  width: 100%;
  height: 240rpx;
  background: #F5F7F6;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #2C3E2D;
  border: 2rpx solid #E8EDE9;
}

/* 匿名开关 + 字数统计 */
.composer-options {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}
.anon-toggle {
  display: flex;
  align-items: center;
}
.toggle-switch {
  width: 76rpx;
  height: 42rpx;
  border-radius: 21rpx;
  background: #D8E0DC;
  position: relative;
  transition: background 0.25s ease;
  margin-right: 14rpx;
}
.toggle-switch.on {
  background: linear-gradient(135deg, #3CB371, #2E8B57);
}
.toggle-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.25s ease;
}
.toggle-switch.on .toggle-knob {
  transform: translateX(34rpx);
}
.anon-label {
  font-size: 26rpx;
  color: #5A6B5D;
  font-weight: 500;
}
.composer-count {
  font-size: 22rpx;
  color: #B8C5BC;
}

.composer-foot {
  margin-top: 24rpx;
}
.composer-actions {
  display: flex;
  justify-content: flex-end;
}
.composer-btn {
  margin-left: 16rpx;
  min-width: 160rpx;
}
