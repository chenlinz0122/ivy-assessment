<!-- pages/community/reportDetail.wxml - 测评报告分享详情页 -->
<view class="detail-page" wx:if="{{post}}">

  <!-- 报告分享帖正文卡片 -->
  <view class="card detail-post-card">
    <!-- 用户信息 + 测评类型标签 -->
    <view class="post-head">
      <view class="post-avatar {{post.anonymous ? 'avatar-anon' : ''}}">
        <image wx:if="{{post.avatar && !post.anonymous}}" class="avatar-img" src="{{post.avatar}}" mode="aspectFill"></image>
        <text wx:elif="{{post.anonymous}}">🌿</text>
        <text wx:else>👤</text>
      </view>
      <view class="post-author">
        <view class="post-nick">{{post.nickName}}</view>
        <view class="post-time">⏰ {{post.time}}</view>
      </view>
      <view class="assess-tag" wx:if="{{post.assessTag}}">
        <text class="assess-tag-icon">{{post.assessIcon}}</text>
        <text class="assess-tag-text">{{post.assessTag}}</text>
      </view>
    </view>

    <!-- 报告摘要标题 -->
    <view class="report-summary-label" wx:if="{{post.assessName}}">📋 {{post.assessName}} · 报告摘要</view>

    <!-- 完整正文（富文本渲染，支持简单排版） -->
    <rich-text class="post-content-full" html="{{post.contentHtml}}"></rich-text>

    <!-- 互动栏 -->
    <view class="post-foot">
      <view class="foot-btn {{post.liked ? 'liked' : ''}}" bindtap="onLike">
        <text class="foot-icon">{{post.liked ? '❤️' : '🤍'}}</text>
        <text>{{post.likes}}</text>
      </view>
      <view class="foot-btn">
        <text class="foot-icon">💬</text>
        <text>{{post.comments}}</text>
      </view>
    </view>
  </view>

  <!-- 评论区 -->
  <view class="section-label">
    <view class="label-bar"></view>
    <text>评论 ({{comments.length}})</text>
  </view>

  <view class="comment-list">
    <view class="card comment-item" wx:for="{{comments}}" wx:key="_id">
      <view class="comment-avatar {{item.anonymous ? 'avatar-anon' : ''}}" style="{{item.anonymous ? '' : 'background:' + item.avatarColor}}">
        <image wx:if="{{item.avatar && !item.anonymous}}" class="avatar-img" src="{{item.avatar}}" mode="aspectFill"></image>
        <text wx:else>{{item.initial}}</text>
      </view>
      <view class="comment-body">
        <view class="comment-nick">{{item.nickName}}</view>
        <view class="comment-content">{{item.content}}</view>
        <view class="comment-time">{{item.time}}</view>
      </view>
    </view>
  </view>

  <!-- 评论空状态 -->
  <view class="empty" wx:if="{{comments.length === 0}}">
    <view class="empty-emoji">💭</view>
    <view class="empty-text">还没有评论，来说点什么吧</view>
  </view>

  <view class="tip-bottom" wx:if="{{comments.length}}">— 已显示全部评论 —</view>

  <!-- 底部评论输入栏 -->
  <view class="comment-bar">
    <input class="comment-input" placeholder="写下你的评论…"
           value="{{commentInput}}" bindinput="onCommentInput" confirm-type="send" bindconfirm="submitComment" />
    <view class="anon-mini {{commentAnonymous ? 'on' : ''}}" bindtap="toggleCommentAnonymous">
      {{commentAnonymous ? '🌿匿' : '👤'}}
    </view>
    <view class="comment-send" bindtap="submitComment">发送</view>
  </view>

</view>
