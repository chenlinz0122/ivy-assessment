/* pages/community/reportDetail.wxss - 测评报告分享详情页 */

.detail-page {
  padding: 24rpx;
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 帖子正文卡片 */
.detail-post-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.post-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.post-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #E8F5EC, #C8E6D0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(46, 139, 87, 0.10);
  overflow: hidden;
}
.post-avatar.avatar-anon {
  background: linear-gradient(135deg, #E0E5E2, #C8D0CC);
}
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 44rpx;
}
.post-author {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.post-nick {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E2D;
}
.post-time {
  font-size: 22rpx;
  color: #9AAAA0;
  margin-top: 4rpx;
}

/* 测评类型标签 */
.assess-tag {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #E8F5EC, #D4ECD9);
  border-radius: 20rpx;
  padding: 8rpx 18rpx;
  flex-shrink: 0;
}
.assess-tag-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}
.assess-tag-text {
  font-size: 22rpx;
  color: #2E8B57;
  font-weight: 600;
}

/* 报告摘要标题 */
.report-summary-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #2E7D32;
  background: #E8F5EC;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

/* 完整正文 */
.post-content-full {
  font-size: 30rpx;
  color: #2C3E2D;
  line-height: 1.8;
  margin-bottom: 20rpx;
  word-break: break-all;
}

/* 互动栏 */
.post-foot {
  display: flex;
  align-items: center;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0F4F1;
}
.foot-btn {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #7A8A7C;
  margin-right: 48rpx;
  transition: transform 0.12s ease;
}
.foot-btn:active {
  transform: scale(0.92);
}
.foot-icon {
  margin-right: 8rpx;
  font-size: 30rpx;
}
.foot-btn.liked {
  color: #E74C3C;
}

/* 区块标题 */
.section-label {
  display: flex;
  align-items: center;
  margin: 8rpx 4rpx 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #2C3E2D;
}
.label-bar {
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(135deg, #3CB371, #2E7D32);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

/* 评论列表 */
.comment-list {
  margin-top: 4rpx;
}
.comment-item {
  display: flex;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #E8F5EC, #C8E6D0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex-shrink: 0;
  overflow: hidden;
  line-height: 1;
}
.comment-avatar.avatar-anon {
  background: linear-gradient(135deg, #E0E5E2, #C8D0CC);
}
.comment-body {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}
.comment-nick {
  font-size: 26rpx;
  font-weight: 600;
  color: #2E7D32;
  margin-bottom: 6rpx;
}
.comment-content {
  font-size: 28rpx;
  color: #2C3E2D;
  line-height: 1.6;
  word-break: break-all;
}
.comment-time {
  font-size: 22rpx;
  color: #9AAAA0;
  margin-top: 8rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 40rpx;
}
.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #7A8A7C;
}
.tip-bottom {
  text-align: center;
  font-size: 24rpx;
  color: #B8C5BC;
  padding: 24rpx 0;
}

/* 底部评论输入栏 */
.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 50;
}
.comment-input {
  flex: 1;
  height: 72rpx;
  background: #F5F7F6;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #2C3E2D;
}
.anon-mini {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 12rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
  background: #F5F7F6;
  color: #9AAAA0;
  flex-shrink: 0;
  transition: all 0.2s ease;
  line-height: 1;
}
.anon-mini.on {
  background: #E8F5EC;
  color: #2E7D32;
  font-weight: 600;
}
.comment-send {
  padding: 0 28rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #3CB371, #2E7D32);
  color: #FFFFFF;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
  line-height: 1;
}
.comment-send:active {
  transform: scale(0.95);
}
