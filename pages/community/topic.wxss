/* pages/community/topic.wxss - 话题讨论独立空间 */

.topic-page {
  padding: 24rpx;
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 页面头部 */
.page-head {
  padding: 16rpx 4rpx 20rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2C3E2D;
}
.page-sub {
  font-size: 24rpx;
  color: #7A8A7C;
  margin-top: 8rpx;
}

/* 顶部分类标签（横向滑动） */
.cat-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.cat-bar {
  display: inline-flex;
  padding: 4rpx 0;
}
.cat-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 30rpx;
  margin-right: 16rpx;
  background: #FFFFFF;
  color: #5A6B5D;
  font-size: 26rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(46, 139, 87, 0.06);
  transition: all 0.2s ease;
  flex-shrink: 0;
  line-height: 1.2;
}
.cat-chip.active {
  color: #FFFFFF;
  font-weight: 600;
  background: linear-gradient(135deg, #3CB371, #2E7D32);
  box-shadow: 0 4rpx 14rpx rgba(46, 125, 50, 0.28);
}

/* 帖子卡片 */
.post-list {
  margin-top: 4rpx;
}
.topic-post-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.post-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #E8F5EC, #C8E6D0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(46, 139, 87, 0.10);
  overflow: hidden;
}
.post-avatar.avatar-anon {
  background: linear-gradient(135deg, #E0E5E2, #C8D0CC);
}
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 40rpx;
}
.post-author {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.post-nick {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3E2D;
}
.post-time {
  font-size: 22rpx;
  color: #9AAAA0;
  margin-top: 4rpx;
}

/* 话题分类标签 */
.cat-tag {
  font-size: 22rpx;
  color: #2E7D32;
  background: #E8F5EC;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* 帖子正文 */
.post-content {
  font-size: 28rpx;
  color: #2C3E2D;
  line-height: 1.7;
  margin-bottom: 16rpx;
}
.post-more {
  color: #2E7D32;
  font-weight: 600;
  margin-left: 8rpx;
}

/* 图片缩略图 */
.post-images {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}
.post-img-item {
  width: 200rpx;
  height: 200rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 10rpx rgba(46, 139, 87, 0.10);
}
.post-img-item image {
  width: 100%;
  height: 100%;
}

/* 帖子底部 */
.post-foot {
  display: flex;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F4F1;
}
.foot-btn {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #7A8A7C;
  margin-right: 48rpx;
  transition: transform 0.12s ease;
}
.foot-btn:active {
  transform: scale(0.92);
}
.foot-icon {
  margin-right: 8rpx;
  font-size: 30rpx;
}
.foot-btn.liked {
  color: #E74C3C;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
}
.empty-emoji {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #7A8A7C;
  margin-bottom: 8rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #B8C5BC;
}
.tip-bottom {
  text-align: center;
  font-size: 24rpx;
  color: #B8C5BC;
  padding: 24rpx 0;
}

/* 悬浮发帖按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #3CB371, #2E7D32);
  color: #FFFFFF;
  border-radius: 52rpx;
  font-size: 56rpx;
  font-weight: 300;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.40);
  z-index: 50;
}
.fab:active {
  transform: scale(0.92);
}

/* ===== 发帖弹层 ===== */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.composer-box {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
.composer-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C3E2D;
  text-align: center;
  margin-bottom: 24rpx;
}

/* 话题分类选择 */
.compose-cat-label {
  font-size: 26rpx;
  color: #5A6B5D;
  font-weight: 600;
  margin-bottom: 14rpx;
}
.required {
  color: #E74C3C;
}
.compose-cat-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.compose-cat-bar {
  display: inline-flex;
}
.compose-cat-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 26rpx;
  margin-right: 14rpx;
  background: #F5F7F6;
  color: #5A6B5D;
  font-size: 24rpx;
  border-radius: 26rpx;
  border: 2rpx solid #E8EDE9;
  flex-shrink: 0;
  transition: all 0.2s ease;
  line-height: 1.2;
}
.compose-cat-chip.active {
  color: #FFFFFF;
  font-weight: 600;
  background: linear-gradient(135deg, #3CB371, #2E7D32);
  border-color: #2E7D32;
}

/* 文本输入 */
.composer-input {
  width: 100%;
  min-height: 220rpx;
  background: #F5F7F6;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #2C3E2D;
  border: 2rpx solid #E8EDE9;
}

/* 图片上传区域 */
.compose-images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  margin-bottom: 8rpx;
}
.compose-img-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin-right: 14rpx;
  margin-bottom: 14rpx;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 10rpx rgba(46, 139, 87, 0.10);
}
.compose-img-item image {
  width: 100%;
  height: 100%;
}
.compose-img-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 300;
  line-height: 1;
}
.compose-img-add {
  width: 180rpx;
  height: 180rpx;
  background: #F5F7F6;
  border: 2rpx dashed #B8C5BC;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9AAAA0;
  margin-right: 14rpx;
  margin-bottom: 14rpx;
}
.compose-img-add:active {
  background: #EDF1EE;
}
.add-icon {
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
}
.add-text {
  font-size: 22rpx;
  margin-top: 6rpx;
}

/* 匿名开关 + 字数统计 */
.composer-options {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.anon-toggle {
  display: flex;
  align-items: center;
}
.toggle-switch {
  width: 76rpx;
  height: 42rpx;
  border-radius: 21rpx;
  background: #D8E0DC;
  position: relative;
  transition: background 0.25s ease;
  margin-right: 14rpx;
}
.toggle-switch.on {
  background: linear-gradient(135deg, #3CB371, #2E7D32);
}
.toggle-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.25s ease;
}
.toggle-switch.on .toggle-knob {
  transform: translateX(34rpx);
}
.anon-label {
  font-size: 26rpx;
  color: #5A6B5D;
  font-weight: 500;
}
.composer-count {
  font-size: 22rpx;
  color: #B8C5BC;
}

/* 操作按钮 */
.composer-foot {
  margin-top: 24rpx;
}
.composer-actions {
  display: flex;
  justify-content: flex-end;
}
.composer-btn {
  margin-left: 16rpx;
  min-width: 160rpx;
}
