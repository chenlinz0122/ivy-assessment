/* pages/index/index.wxss - 首页（植物编辑风 · Botanical Editorial） */
/* 设计方向：深森林渐变 · 阳光斑驳 · 编辑式排版 · Bento 错落布局 */

/* 进场动画关键帧 */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(28rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes shimmer {
  0%   { transform: translateX(-100%) skewX(-20deg); }
  100% { transform: translateX(200%) skewX(-20deg); }
}

/* ===== 主容器 + 多层 mesh 背景 ===== */
.home {
  position: relative;
  padding: 0 0 80rpx;
  min-height: 100vh;
  background: #F2F6F1;
  overflow: hidden;
}

/* mesh 渐变层：模拟阳光穿过叶片的斑驳光影 */
.bg-mesh {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 100vh;
  background:
    radial-gradient(circle at 15% 12%, rgba(46, 125, 50, 0.18) 0%, transparent 38%),
    radial-gradient(circle at 88% 8%, rgba(204, 184, 92, 0.14) 0%, transparent 32%),
    radial-gradient(circle at 75% 55%, rgba(46, 125, 50, 0.10) 0%, transparent 42%),
    radial-gradient(circle at 10% 80%, rgba(0, 105, 92, 0.10) 0%, transparent 40%),
    linear-gradient(180deg, #E8F0E5 0%, #F2F6F1 280rpx, #F5F7F6 100%);
  z-index: 0;
  pointer-events: none;
}

/* 细微噪点纹理层：增加质感 */
.bg-grain {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 100vh;
  background-image:
    radial-gradient(rgba(46, 125, 50, 0.025) 1rpx, transparent 1rpx),
    radial-gradient(rgba(46, 125, 50, 0.018) 1rpx, transparent 1rpx);
  background-size: 32rpx 32rpx, 24rpx 24rpx;
  background-position: 0 0, 12rpx 12rpx;
  z-index: 0;
  pointer-events: none;
  opacity: 0.6;
}

/* 所有内容层级高于背景 */
.top-bar, .banner-swiper, .stats-section, .category-section, .brand-footer {
  position: relative;
  z-index: 1;
}

/* 错落进场动画 */
.anim-up {
  animation: fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
}

/* ===== 模块1：顶部用户区 ===== */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 36rpx 24rpx;
}
.user-zone {
  display: flex;
  align-items: center;
  flex: 1;
}
.user-avatar {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.avatar-ring {
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
  border-radius: 50%;
  background: conic-gradient(from 180deg, #2E7D32, #66BB6A, #C5E1A5, #2E7D32);
  z-index: 0;
}
.user-avatar::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #C8E6C9, #A5D6A7);
  border: 4rpx solid #FFFFFF;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-img {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  z-index: 2;
}
.avatar-emoji {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}
.user-greeting {
  flex: 1;
  overflow: hidden;
}
.greeting-hi {
  font-size: 32rpx;
  font-weight: 500;
  color: #2C3E2D;
  letter-spacing: 0.5rpx;
}
.greeting-name {
  font-weight: 800;
  color: #1B5E20;
}
.greeting-sub {
  font-size: 23rpx;
  color: #6B7D6E;
  letter-spacing: 0.5rpx;
}
.greeting-row {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
  gap: 12rpx;
  flex-wrap: wrap;
}
/* 学习天数标签 */
.study-tag {
  font-size: 20rpx;
  color: #1B5E20;
  background: rgba(46, 125, 50, 0.12);
  border: 1rpx solid rgba(46, 125, 50, 0.2);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  line-height: 1.4;
}
.greeting-wave {
  margin-left: 4rpx;
  display: inline-block;
  animation: fadeUp 0.6s ease 0.5s both;
}
.notice-btn {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(46, 125, 50, 0.12);
  backdrop-filter: blur(8rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}
.notice-btn:active {
  transform: scale(0.92);
}
.notice-icon {
  font-size: 36rpx;
}
.notice-dot {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #E53935;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 0 0 0 rgba(229, 57, 53, 0.5);
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%   { box-shadow: 0 0 0 0 rgba(229, 57, 53, 0.5); }
  70%  { box-shadow: 0 0 0 12rpx rgba(229, 57, 53, 0); }
  100% { box-shadow: 0 0 0 0 rgba(229, 57, 53, 0); }
}

/* ===== 模块2：Banner 轮播 ===== */
.banner-swiper {
  height: 400rpx;
  margin: 8rpx 32rpx 32rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow:
    0 20rpx 40rpx rgba(13, 59, 26, 0.32),
    0 4rpx 12rpx rgba(46, 125, 50, 0.18);
}
.banner-card {
  position: relative;
  height: 100%;
  overflow: hidden;
}
/* 有机曲线装饰 - 模拟叶片轮廓 */
.banner-curve-1 {
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50% 30% 50% 40%;
  background: rgba(255, 255, 255, 0.08);
  transform: rotate(-25deg);
}
.banner-curve-2 {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 60% 40% 50% 30%;
  background: rgba(255, 255, 255, 0.06);
  transform: rotate(45deg);
}
.banner-curve-3 {
  position: absolute;
  bottom: -100rpx;
  left: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50% 40% 30% 50%;
  background: rgba(255, 255, 255, 0.04);
  transform: rotate(20deg);
}
.banner-emoji {
  position: absolute;
  top: 36rpx;
  right: 44rpx;
  font-size: 120rpx;
  opacity: 0.5;
  z-index: 1;
  filter: drop-shadow(0 4rpx 12rpx rgba(0, 0, 0, 0.2));
}
.banner-content {
  position: relative;
  z-index: 2;
  padding: 60rpx 44rpx 0;
}
.banner-title {
  font-size: 38rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.3;
  letter-spacing: 0.5rpx;
}
.banner-highlight {
  font-size: 52rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.25;
  margin: 4rpx 0 18rpx;
  letter-spacing: 1rpx;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.25);
}
.banner-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 32rpx;
  letter-spacing: 1rpx;
}
.banner-btn {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 32rpx 14rpx 36rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
  backdrop-filter: blur(12rpx);
  letter-spacing: 1rpx;
  line-height: 1;
}
.banner-btn-arrow {
  margin-left: 12rpx;
  font-size: 28rpx;
  font-weight: 400;
  transition: transform 0.2s ease;
}
.banner-card:active .banner-btn-arrow {
  transform: translateX(6rpx);
}
/* 玻璃拟态光带 */
.banner-glow {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
}

/* ===== 氛围条：今日实时数据 ===== */
.vibe-bar {
  display: flex;
  align-items: center;
  margin: 0 32rpx 20rpx;
  padding: 14rpx 24rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 32rpx;
  backdrop-filter: blur(8rpx);
  border: 1rpx solid rgba(46, 125, 50, 0.08);
}
.vibe-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #43A047;
  margin-right: 14rpx;
  box-shadow: 0 0 0 4rpx rgba(67, 160, 71, 0.2);
  animation: pulse-green 2s infinite;
}
@keyframes pulse-green {
  0%   { box-shadow: 0 0 0 0 rgba(67, 160, 71, 0.5); }
  70%  { box-shadow: 0 0 0 10rpx rgba(67, 160, 71, 0); }
  100% { box-shadow: 0 0 0 0 rgba(67, 160, 71, 0); }
}
.vibe-text {
  font-size: 22rpx;
  color: #6B7D6E;
  letter-spacing: 0.5rpx;
}
.vibe-num {
  color: #1B5E20;
  font-weight: 700;
  font-size: 24rpx;
}

/* ===== 学习打卡卡片 ===== */
.checkin-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 32rpx 32rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 60%, #388E3C 100%);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 28rpx rgba(13, 59, 26, 0.25);
  transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
}
.checkin-card:active {
  transform: scale(0.97);
}
.checkin-deco {
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  pointer-events: none;
}
.checkin-left {
  position: relative;
  z-index: 1;
  flex: 1;
}
.checkin-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 0.5rpx;
  margin-bottom: 6rpx;
}
.checkin-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 0.5rpx;
}
.checkin-btn {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
  backdrop-filter: blur(8rpx);
  letter-spacing: 0.5rpx;
  line-height: 1;
}

/* ===== 模块3：核心数据看板（英雄区） ===== */
.stats-section {
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}
.stats-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.stats-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #6B7D6E;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}
.stats-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(107, 125, 110, 0.3), transparent);
  margin-left: 20rpx;
}
.stats-board {
  display: flex;
  gap: 16rpx;
}
.stat-card {
  position: relative;
  flex: 1;
  background: linear-gradient(165deg, #FFFFFF 0%, #F4F8F3 100%);
  border-radius: 24rpx;
  padding: 32rpx 16rpx 28rpx;
  text-align: center;
  box-shadow:
    0 10rpx 28rpx rgba(46, 125, 50, 0.10),
    0 2rpx 6rpx rgba(46, 125, 50, 0.04);
  border: 1rpx solid rgba(46, 125, 50, 0.08);
  overflow: hidden;
}
.stat-icon {
  font-size: 32rpx;
  margin-bottom: 12rpx;
  opacity: 0.85;
}
.stat-num {
  font-size: 52rpx;
  font-weight: 800;
  color: #1B5E20;
  line-height: 1.1;
  letter-spacing: -2rpx;
  font-feature-settings: "tnum";
}
.stat-label {
  font-size: 22rpx;
  color: #6B7D6E;
  margin-top: 10rpx;
  letter-spacing: 0.5rpx;
}
.stat-trend {
  font-size: 19rpx;
  color: #2E7D32;
  margin-top: 12rpx;
  padding: 4rpx 14rpx;
  background: rgba(46, 125, 50, 0.08);
  border-radius: 12rpx;
  display: inline-block;
  font-weight: 600;
}
/* 卡片光泽扫过效果 */
.stat-shine {
  position: absolute;
  top: 0;
  left: 0;
  width: 50%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  opacity: 0;
  pointer-events: none;
}
.stat-card:active .stat-shine {
  animation: shimmer 0.8s ease;
}

/* ===== 模块4：四大分类入口（2x2 等大网格） ===== */
.category-section {
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}
.cat-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.cat-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1B3A1F;
  letter-spacing: 0.5rpx;
}
.cat-sub {
  font-size: 22rpx;
  color: #8A9A8C;
  letter-spacing: 1rpx;
}

/* 2x2 等大网格 - 手机端兼容写法 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.cat-card {
  position: relative;
  width: 332rpx;          /* 固定宽度（750rpx - 左右32rpx padding - 16rpx gap）/ 2 = 335rpx，取332rpx 留余量 */
  height: 220rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
  box-shadow:
    0 12rpx 28rpx rgba(13, 59, 26, 0.22),
    0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.18s ease;
}
.cat-card:active {
  transform: scale(0.96);
  box-shadow:
    0 6rpx 14rpx rgba(13, 59, 26, 0.18),
    0 1rpx 4rpx rgba(0, 0, 0, 0.06);
}

/* 卡片装饰光斑 */
.cat-card-deco {
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.10);
  pointer-events: none;
}
.cat-card-icon {
  font-size: 64rpx;
  filter: drop-shadow(0 4rpx 12rpx rgba(0, 0, 0, 0.2));
  z-index: 1;
}
.cat-card-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  z-index: 1;
}
.cat-card-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 0.5rpx;
  margin-top: 4rpx;
  z-index: 1;
}
.cat-card-count {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.18);
  padding: 6rpx 16rpx;
  border-radius: 14rpx;
  font-weight: 600;
  backdrop-filter: blur(8rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  z-index: 2;
}

/* ===== 底部留白 ===== */
.bottom-spacer {
  height: 40rpx;
}
