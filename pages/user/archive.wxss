/* pages/user/archive.wxss - 我的成长档案 */
.archive-page {
  padding: 24rpx;
  padding-bottom: 80rpx;
}

/* 档案头部 */
.archive-header {
  position: relative;
  background: linear-gradient(135deg, #2E8B57 0%, #1F6E42 100%);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}
.header-deco {
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 220rpx;
  height: 220rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}
.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  position: relative;
}
.header-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
  position: relative;
}

/* 概览卡片 */
.overview-card {
  padding: 32rpx;
}
.overview-row {
  display: flex;
  align-items: center;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #E8EDE9;
}
.overview-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8F5EC, #C8E6D0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
}
.overview-info {
  flex: 1;
}
.overview-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C3E2D;
}
.overview-meta {
  font-size: 24rpx;
  color: #7A8A7C;
  margin-top: 6rpx;
}
.overview-level {
  display: inline-block;
  margin-top: 10rpx;
  padding: 4rpx 16rpx;
  background: #E8F5EC;
  color: #2E8B57;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.overview-stats {
  display: flex;
  align-items: center;
  padding-top: 28rpx;
}
.ov-stat {
  flex: 1;
  text-align: center;
}
.ov-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #2E8B57;
  line-height: 1.2;
}
.ov-label {
  font-size: 22rpx;
  color: #7A8A7C;
  margin-top: 6rpx;
}
.ov-divider {
  width: 1rpx;
  height: 56rpx;
  background: #E8EDE9;
}

/* 分类标签 */
.section-label {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #2C3E2D;
  margin: 32rpx 0 16rpx;
}
.label-bar {
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(180deg, #3CB371, #2E8B57);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

/* 摘要卡片 */
.summary-card {
  padding: 28rpx;
}
.summary-top {
  display: flex;
  align-items: center;
}
.summary-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #E8F5EC, #D4ECD9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}
.summary-main {
  flex: 1;
}
.summary-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #2C3E2D;
}
.summary-date {
  font-size: 22rpx;
  color: #B8C5BC;
  margin-top: 6rpx;
}
.summary-arrow {
  font-size: 36rpx;
  color: #B8C5BC;
}
.summary-content {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #F5F7F6;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #5A6B5D;
}
.summary-title {
  color: #2E8B57;
  font-weight: 600;
}

/* 时间轴 */
.timeline-card {
  padding: 28rpx 32rpx;
}
.timeline-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  position: relative;
}
.timeline-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 40rpx;
  bottom: -10rpx;
  width: 2rpx;
  background: #E8EDE9;
}
.tl-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #3CB371;
  margin-right: 24rpx;
  flex-shrink: 0;
  border: 4rpx solid #E8F5EC;
}
.tl-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.tl-name {
  font-size: 28rpx;
  color: #2C3E2D;
}
.tl-time {
  font-size: 22rpx;
  color: #B8C5BC;
}

/* 导出按钮 */
.export-wrap {
  margin-top: 40rpx;
  text-align: center;
}
.export-btn {
  width: 100%;
}
.export-tip {
  font-size: 22rpx;
  color: #B8C5BC;
  margin-top: 16rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
}
.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 30rpx;
  color: #5A6B5D;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #B8C5BC;
  margin-bottom: 32rpx;
}
.empty-btn {
  width: 320rpx;
  margin: 0 auto;
}

/* 隐藏的导出 canvas */
.archive-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
}
