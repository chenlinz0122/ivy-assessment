/* pages/user/badges.wxss */
.badges-page { padding: 24rpx; padding-bottom: 60rpx; }

/* 未登录 */
.empty-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.login-btn { width: 400rpx; margin: 30rpx auto; }

/* 积分概览 */
.points-card {
  position: relative;
  background: linear-gradient(135deg, #2E8B57, #1F6E42);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  color: #FFFFFF;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 28rpx rgba(46, 139, 87, 0.22);
}
.points-card::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.10);
}
.points-card::after {
  content: '';
  position: absolute;
  bottom: -50rpx;
  left: -40rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}
.points-num,
.points-label,
.level-badge,
.earn-btn {
  position: relative;
}
.points-num {
  font-size: 80rpx;
  font-weight: 700;
  line-height: 1;
}
.points-label {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}
.level-badge {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 28rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 24rpx;
  font-size: 26rpx;
  margin-top: 24rpx;
}
.level-icon { margin-right: 10rpx; }
.earn-btn {
  width: 320rpx;
  margin: 28rpx auto 0;
  background: rgba(255,255,255,0.95);
  color: #2E8B57;
  border: none;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
}
.earn-btn::after { border: none; }

.badges-page .card { margin-bottom: 24rpx; }

/* 积分规则 */
.rule-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #5A6B5D;
  border-bottom: 1rpx solid #F0F4F1;
}
.rule-item:last-child { border-bottom: none; }
.rule-pts { color: #2E8B57; font-weight: 600; }

/* 徽章墙 */
.badge-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.badge-item {
  width: 31%;
  background: #F5F7F6;
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  margin-bottom: 20rpx;
}
.badge-item.locked { opacity: 0.55; }
.badge-icon { font-size: 56rpx; margin-bottom: 10rpx; }
.badge-name { font-size: 24rpx; font-weight: 600; color: #2C3E2D; margin-bottom: 6rpx; }
.badge-desc { font-size: 20rpx; color: #9AAAA0; line-height: 1.4; }
.badge-progress {
  font-size: 20rpx;
  color: #2E8B57;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  background: #E8F5EC;
  border-radius: 12rpx;
  display: inline-block;
}
.badge-item.locked .badge-progress { color: #9AAAA0; background: #EEF0EE; }

/* 排行榜 */
.board-tabs {
  display: flex;
  background: #F5F7F6;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}
.board-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #7A8A7C;
  border-radius: 10rpx;
}
.board-tab.active {
  background: #FFFFFF;
  color: #2E8B57;
  font-weight: 600;
}
.my-rank {
  font-size: 24rpx;
  color: #2E8B57;
  margin-bottom: 16rpx;
}
.rank-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0F4F1;
}
.rank-item.me {
  background: #E8F5EC;
  border-radius: 12rpx;
  padding: 18rpx 16rpx;
  margin: 0 -16rpx;
  border-bottom: none;
}
.rank-num {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #9AAAA0;
}
.rank-name {
  flex: 1;
  font-size: 28rpx;
  color: #2C3E2D;
}
.rank-pts {
  font-size: 28rpx;
  color: #2E8B57;
  font-weight: 600;
}

/* 积分明细 */
.log-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F4F1;
}
.log-item:last-child { border-bottom: none; }
.log-reason { font-size: 28rpx; color: #2C3E2D; }
.log-time { font-size: 22rpx; color: #B8C5BC; margin-top: 6rpx; }
.log-value { font-size: 32rpx; font-weight: 700; }
.log-value.plus { color: #2E8B57; }
.log-value.minus { color: #E74C3C; }
